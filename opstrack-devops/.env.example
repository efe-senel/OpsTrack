POSTGRES_DB=opstrack
POSTGRES_USER=opstrack
POSTGRES_PASSWORD=replace-with-a-strong-local-password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_PATH=./nginx/certs/certificate.crt
TLS_KEY_PATH=./nginx/certs/private.key

# Zabbix uses a dedicated PostgreSQL database and volume.
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=replace-with-a-strong-zabbix-database-password
ZABBIX_ADMIN_USER=Admin
# Initial password in the official Zabbix image. Change it in the web UI after first login,
# then update the local .env value so the bootstrap remains idempotent.
ZABBIX_ADMIN_PASSWORD=zabbix
ZABBIX_AGENT_HOSTNAME=opstrack-docker-host
ZABBIX_WEB_PORT=8082
TZ=Europe/Istanbul

# Gmail SMTP notifications (use a Google app password, never an account password).
ZABBIX_SMTP_SERVER=smtp.gmail.com
ZABBIX_SMTP_PORT=587
ZABBIX_SMTP_SECURITY=STARTTLS
ZABBIX_SMTP_EMAIL=example@gmail.com
ZABBIX_SMTP_USERNAME=example@gmail.com
ZABBIX_SMTP_APP_PASSWORD=replace_with_google_app_password
ZABBIX_ALERT_RECIPIENT=example@gmail.com

# Central logging UI.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-local-grafana-password
